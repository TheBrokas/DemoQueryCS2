{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DemoQueryCS2",
  "version": "1.0.0",
  "identifier": "com.demoquerycs2.desktop",
  "build": {
    "frontendDist": "../dist-ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DemoQueryCS2",
        "width": 1520,
        "height": 860,
        "minWidth": 1200,
        "minHeight": 720,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": false,
    "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png"],
    "resources": {
      "../dist-server/cs2sf-server": "server",
      "../THIRD_PARTY_LICENSES.txt": "THIRD_PARTY_LICENSES.txt"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "DemoQueryCS2"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhCMTAzNDFBNDhDREI4QUUKUldTdXVNMUlHalFRaTRZWmtuVlZYdFpQMkx0bEZ6TmFzUng4TDByWmt0MWFzakhGR08vaU1qdWMK",
      "endpoints": ["https://github.com/TheBrokas/DemoQueryCS2/releases/latest/download/latest.json"]
    }
  }
}
